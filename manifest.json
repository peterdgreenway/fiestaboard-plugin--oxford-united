{
  "id": "oxford_united",
  "name": "Oxford United",
  "version": "1.2.0",
  "description": "Oxford United: live match (minute, HT/FT, scorers) with refresh every n seconds (default 120) and Run refresh now. When idle, next opponent H/A date/time block.",
  "author": "peterdgreenway",
  "icon": "trophy",
  "category": "data",
  "repository": "https://github.com/peterdgreenway/fiestaboard-plugin--oxford-united",
  "teaser": "LIVE 1-0 67'   ",
  "previews": [
    {
      "device_type": "note",
      "rows": [
        "LIVE 1-0 67'   ",
        "OXF vs BRA     ",
        "Cheek 67'      "
      ]
    },
    {
      "device_type": "flagship",
      "rows": [
        "   OXFORD UNITED      ",
        "LIVE  OXF 1-0 BRA     ",
        "MIN 67'  HT 0-0       ",
        "Cheek 67'             ",
        "                      ",
        "                      "
      ]
    }
  ],
  "settings_schema": {
    "type": "object",
    "properties": {
      "run_refresh_now": {
        "type": "boolean",
        "title": "Run refresh now",
        "description": "Turn ON and Save Changes to fetch the latest live score, minute and scorers immediately.",
        "default": false
      },
      "refresh_seconds": {
        "type": "integer",
        "title": "Refresh interval while live (seconds)",
        "description": "How often to re-fetch when a match is in progress. Default 120. Also set FiestaBoard page refresh to match.",
        "default": 120,
        "minimum": 60,
        "maximum": 3600
      },
      "api_key": {
        "type": "string",
        "title": "TheSportsDB API Key (optional)",
        "description": "Free key '123' works. Premium key gives higher limits.",
        "default": "123",
        "ui:widget": "password"
      },
      "show_form": {
        "type": "boolean",
        "title": "Show recent form",
        "description": "Include last 5 results form string (e.g. WWDLW)",
        "default": true
      },
      "max_scorers": {
        "type": "integer",
        "title": "Max scorers in summary line",
        "description": "How many scorers to show in formatted_scorers (1-6)",
        "default": 4,
        "minimum": 1,
        "maximum": 6
      }
    }
  },
  "variables": {
    "simple": [
      "team",
      "position",
      "points",
      "played",
      "won",
      "drawn",
      "lost",
      "gf",
      "ga",
      "gd",
      "form",
      "last_home",
      "last_away",
      "last_date",
      "last_status",
      "last_result",
      "ht_home",
      "ht_away",
      "ht_score",
      "ft_home",
      "ft_away",
      "ft_score",
      "last_score",
      "scorers",
      "scorer_count",
      "scorer_1",
      "scorer_2",
      "scorer_3",
      "scorer_4",
      "formatted_table",
      "formatted_last",
      "formatted_htft",
      "formatted_scorers",
      "formatted_next",
      "next_home",
      "next_away",
      "next_date",
      "next_time",
      "next_opponent",
      "last_updated",
      "match_in_progress",
      "is_live",
      "current_minute",
      "formatted_minute",
      "formatted_live",
      "live_status",
      "display_mode",
      "match_block",
      "next_home_away",
      "next_ha",
      "next_opponent_full",
      "next_row1",
      "next_row2",
      "next_row3",
      "next_match_block",
      "next_match_line",
      "run_refresh_now",
      "refresh_seconds"
    ],
    "arrays": {
      "goals": {
        "label_field": "formatted",
        "item_fields": [
          "minute",
          "player",
          "player_full",
          "team",
          "is_home",
          "is_own",
          "formatted"
        ]
      }
    }
  },
  "max_lengths": {
    "team": 15,
    "position": 2,
    "points": 3,
    "played": 2,
    "won": 2,
    "drawn": 2,
    "lost": 2,
    "gf": 3,
    "ga": 3,
    "gd": 4,
    "form": 5,
    "last_home": 12,
    "last_away": 12,
    "last_date": 10,
    "last_status": 5,
    "last_result": 1,
    "ht_home": 2,
    "ht_away": 2,
    "ht_score": 5,
    "ft_home": 2,
    "ft_away": 2,
    "ft_score": 5,
    "last_score": 5,
    "scorers": 22,
    "scorer_count": 2,
    "scorer_1": 22,
    "scorer_2": 22,
    "scorer_3": 22,
    "scorer_4": 22,
    "formatted_table": 22,
    "formatted_last": 22,
    "formatted_htft": 22,
    "formatted_scorers": 22,
    "formatted_next": 22,
    "next_home": 12,
    "next_away": 12,
    "next_date": 10,
    "next_time": 5,
    "next_opponent": 12,
    "last_updated": 20,
    "goals.*.minute": 3,
    "goals.*.player": 12,
    "goals.*.player_full": 20,
    "goals.*.team": 6,
    "goals.*.is_home": 1,
    "goals.*.is_own": 1,
    "goals.*.formatted": 18,
    "match_in_progress": 3,
    "is_live": 3,
    "current_minute": 8,
    "formatted_minute": 15,
    "formatted_live": 22,
    "live_status": 20,
    "display_mode": 4,
    "match_block": 45,
    "next_home_away": 4,
    "next_ha": 1,
    "next_opponent_full": 40,
    "next_row1": 15,
    "next_row2": 15,
    "next_row3": 15,
    "next_match_block": 50,
    "next_match_line": 45,
    "run_refresh_now": 3,
    "refresh_seconds": 6
  },
  "env_vars": [
    {
      "name": "OXFORD_UNITED_API_KEY",
      "description": "Optional TheSportsDB API key (overrides Integrations setting)",
      "required": false
    }
  ],
  "documentation": "docs/SETUP.md",
  "min_refresh_seconds": 120
}
