{
  "id": "oxford_united",
  "name": "Oxford United",
  "version": "1.5.0",
  "description": "Oxford United League One. Auto live-refresh Sat 15:00\u201317:00 & Tue 19:45\u201321:45 UK; scorers, form tiles, next fixture when idle.",
  "author": "peterdgreenway",
  "icon": "trophy",
  "category": "data",
  "repository": "https://github.com/peterdgreenway/fiestaboard-plugin--oxford-united",
  "teaser": "1-0 67'        ",
  "previews": [
    {
      "device_type": "note",
      "rows": [
        "     LIVE      ",
        " OXF 1-0 BRA   ",
        "      67'      "
      ]
    },
    {
      "device_type": "flagship",
      "rows": [
        "   OXFORD UNITED      ",
        "LIVE  OXF 1-0 BRA     ",
        "MIN 67'  HT 0-0       ",
        "Cheek 67'             ",
        "                      ",
        "                      "
      ]
    }
  ],
  "settings_schema": {
    "type": "object",
    "properties": {
      "run_refresh_now": {
        "type": "boolean",
        "title": "Run refresh now",
        "description": "Turn ON and Save Changes to fetch the latest live score, minute and scorers immediately.",
        "default": false
      },
      "scheduled_refresh_enabled": {
        "type": "boolean",
        "title": "Scheduled game refresh windows",
        "description": "When on, live-rate refresh is active Saturday 15:00\u201317:00 and Tuesday 19:45\u201321:45 (UK time), even if the API has not marked a match live yet. Outside those windows, idle refresh applies unless a match is in progress.",
        "default": true
      },
      "refresh_seconds": {
        "type": "integer",
        "title": "Live refresh interval (seconds)",
        "description": "Used while a match is in progress. Default 120. Set FiestaBoard page refresh to match suggested_refresh_seconds.",
        "default": 120,
        "minimum": 60,
        "maximum": 3600
      },
      "idle_refresh_seconds": {
        "type": "integer",
        "title": "Idle refresh interval (seconds)",
        "description": "When no match is in progress. Default 1800 (30 minutes).",
        "default": 1800,
        "minimum": 300,
        "maximum": 86400
      },
      "api_key": {
        "type": "string",
        "title": "TheSportsDB API Key (optional)",
        "description": "Free key '123' works. Premium key gives higher limits.",
        "default": "123",
        "ui:widget": "password"
      },
      "show_form": {
        "type": "boolean",
        "title": "Show recent form",
        "description": "Include last 5 results form string (e.g. WWDLW)",
        "default": true
      },
      "max_scorers": {
        "type": "integer",
        "title": "Max scorers in summary line",
        "description": "How many scorers to show in formatted_scorers (1-6)",
        "default": 4,
        "minimum": 1,
        "maximum": 6
      },
      "form_games": {
        "type": "integer",
        "title": "Form: last N games",
        "description": "Show form for the last 3 or last 5 matches.",
        "enum": [
          3,
          5
        ],
        "default": 5
      },
      "form_show_letters": {
        "type": "boolean",
        "title": "Form: show W/D/L letters",
        "description": "When off, form is colour tiles only (green/yellow/red, no letters).",
        "default": true
      },
      "form_style": {
        "type": "string",
        "title": "Form display style",
        "description": "last_3_tiles = last three games as colour only (no letters). Other options combine length and letters.",
        "enum": [
          "last_5_letters",
          "last_3_letters",
          "last_5_tiles",
          "last_3_tiles"
        ],
        "default": "last_5_letters"
      }
    }
  },
